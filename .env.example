# The first server start creates this admin account if it does not already exist.
ADMIN_EMAIL=akbuffaloes540@gmail.com
ADMIN_PASSWORD=replace-with-a-private-password-of-at-least-12-characters

# Optional backend port (defaults to 3001).
# API_PORT=3001

# Email notifications (Gmail SMTP)
# Generate an App Password at: https://myaccount.google.com/apppasswords
SMTP_PASS=your-gmail-app-password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=akbuffaloes540@gmail.com
# Optional: where owner/admin notifications are delivered. Defaults to ADMIN_EMAIL.
# ADMIN_NOTIFY_EMAIL=akbuffaloes540@gmail.com
